# One role's sandbox: a pinned system image (BASE), the agent CLIs, and an
# unprivileged user. Nothing from the host is copied in. At run time only
# the role's working copy of the repository is mounted (sandbox/run-role.sh).
ARG BASE
FROM ${BASE}
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates curl ripgrep \
 && rm -rf /var/lib/apt/lists/* \
 && curl -fsSL https://github.com/openai/codex/releases/download/rust-v0.166.0/codex-x86_64-unknown-linux-musl.tar.gz | tar -xz -C /usr/local/bin && mv /usr/local/bin/codex-x86_64-unknown-linux-musl /usr/local/bin/codex
RUN useradd -m -s /bin/bash agent
USER agent
RUN curl -fsSL https://claude.ai/install.sh | bash
ENV PATH=/home/agent/.local/bin:${PATH}
WORKDIR /work
